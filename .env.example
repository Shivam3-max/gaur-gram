# Postgres connection string. On Vercel this is set for you when you connect a Neon database.
# Locally: run `npx prisma dev --name gaurgram` and paste the postgres:// URL it prints.
DATABASE_URL="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable"
SESSION_SECRET="change-me-to-a-long-random-string"
# Vercel Blob (admin uploads in production). Set automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=""

# Razorpay keys from dashboard.razorpay.com → Settings → API Keys.
# Leave empty to run checkout in demo mode (payments are simulated).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Public site address, used in the sitemap
SITE_URL="https://gaurgram.in"

# Admin password used by `npm run db:seed`. Leave empty to generate a random one.
SEED_ADMIN_PASSWORD=""
